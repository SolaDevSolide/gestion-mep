      "attendu": {
        "texte": "{\n  \"titre\": \"[Essai] MEP Paiement\",\n  \"detail\": \"E0005 en échec : erreur \\\"403\\\"\\nau moment de la purge\"\n}",
        "manquantes": [],
        "inconnues": [],
        "erreurs": []
      }
    },
