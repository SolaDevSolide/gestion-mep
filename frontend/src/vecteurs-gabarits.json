    "application": false,
    "donnees_json": false,
    "essai": false,
    "etape_systemes": true,
    "evenement": false,
    "evenement_cle": false,
    "evenement_detail": false,
    "mep_id": false,
    "motif": false,
    "phase": false,
    "pilote": false,
    "sections": true
  },
  "cas": [
    {
      "nom": "JSON simple : texte échappé dans une chaîne",
