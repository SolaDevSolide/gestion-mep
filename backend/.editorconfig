# Règles C# et analyseurs .NET. Complète le .editorconfig de la racine du dépôt.

# ---------- C# : style ----------
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_prefer_braces = when_multiline:silent
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_readonly_field = true:suggestion
csharp_new_line_before_open_brace = all

# Nommage : PascalCase pour les types et membres, _camelCase pour les champs privés.
dotnet_naming_rule.champs_prives.symbols = champs_prives
dotnet_naming_rule.champs_prives.style = souligne_camel
dotnet_naming_rule.champs_prives.severity = suggestion
dotnet_naming_symbols.champs_prives.applicable_kinds = field
dotnet_naming_symbols.champs_prives.applicable_accessibilities = private
dotnet_naming_symbols.champs_prives.required_modifiers =
dotnet_naming_style.souligne_camel.capitalization = camel_case
dotnet_naming_style.souligne_camel.required_prefix = _

# ---------- C# : analyseurs écartés, avec la raison ----------
# Journalisation : volumes faibles, les délégués LoggerMessage n'apportent rien ici.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Le code est écrit en français : les paramètres surchargés gardent leur nom français (arret, b…),
# et les exceptions métier ne se terminent pas par « Exception » (ErreurHttp).
dotnet_diagnostic.CA1725.severity = none
dotnet_diagnostic.CA1710.severity = none
# Le code appelant n'est pas une bibliothèque : pas de ConfigureAwait(false) imposé.
dotnet_diagnostic.CA2007.severity = none

# Migrations EF Core : code généré, non analysé.
[**/Migrations/*.cs]
generated_code = true

# Tests : noms de méthodes en phrases (soulignés), données en ligne, fixtures xUnit.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1852.severity = none
