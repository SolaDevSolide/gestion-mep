# Copier en .env et adapter. Toutes les valeurs ont un défaut pour le poste de dev.
PORT=8080
POSTGRES_USER=mep
POSTGRES_PASSWORD=changer-moi
# true : comptes alice/bob/claire (mot de passe demo) et MEP de démonstration au premier démarrage
DEMO=false
# Compte administrateur créé au premier démarrage si la base est vide
ADMIN_LOGIN=admin
ADMIN_MOT_DE_PASSE=changer-moi
# Image publiée par la CI, pour déployer sans reconstruire :
# MEP_IMAGE=ghcr.io/soladevsolide/gestion-mep:latest
