# Copier en .env et adapter. Toutes les valeurs ont un défaut pour le poste de dev.
PORT=8080
POSTGRES_USER=mep
POSTGRES_PASSWORD=changer-moi
# true : comptes alice/bob/claire (mot de passe demo) et MEP de démonstration au premier démarrage
DEMO=false
# Compte administrateur créé au premier démarrage si la base est vide
ADMIN_LOGIN=admin
ADMIN_MOT_DE_PASSE=changer-moi
# Image publiée par la CI, pour déployer sans reconstruire :
# MEP_IMAGE=ghcr.io/soladevsolide/gestion-mep:latest
# Taille maximale d'une pièce jointe, en Mo (fichiers stockés dans le volume pieces-jointes)
PIECES_TAILLE_MAX_MO=20
# Réseau(x) du reverse proxy HTTPS (CIDR, séparés par des virgules). Défaut : réseaux Docker (proxy sur le même hôte).
# Si le proxy est sur une autre machine, indiquer son adresse, par exemple 10.0.5.12/32.
# PROXY_RESEAUX=172.16.0.0/12
# Tentatives de connexion autorisées par minute et par adresse IP (en plus du blocage d'un compte après 5 échecs)
# CONNEXIONS_PAR_MINUTE=20
