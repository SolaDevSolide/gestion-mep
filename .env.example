# Copier en .env, réservé au compte qui lance Docker (il contient des secrets) :
#   install -m 600 .env.example .env      (Windows : voir docs/Installer.md)
# Toutes les valeurs ont un défaut pour le poste de dev.
# Les réglages marqués (console) se modifient aussi ensuite, sans redémarrage, dans la console d'administration
# (onglet Paramètres) ou par « gestion-mep reglages definir <nom> <valeur> » : la valeur modifiée remplace celle-ci.
# Les autres ne sont lus qu'au démarrage : modifier ce fichier, puis « docker compose up -d ».
PORT=8080
# Adresse sur laquelle le port est publié : 127.0.0.1 (défaut) = joignable seulement depuis cette machine, donc par un
# reverse proxy HTTPS installé ici. Mettre l'adresse de la carte réseau (ou 0.0.0.0) si le proxy est sur une autre machine,
# ou pour un essai depuis un autre poste (avec HTTPS_OBLIGATOIRE=false).
# ADRESSE_ECOUTE=127.0.0.1
POSTGRES_USER=mep
# Mot de passe de la base, à choisir (long et aléatoire, par exemple : openssl rand -base64 24)
POSTGRES_PASSWORD=
# true : comptes alice/bob/claire (mot de passe demo) et MEP de démonstration au premier démarrage
DEMO=false
# Compte administrateur créé au premier démarrage si la base est vide. Laisser le mot de passe vide : un mot de passe
# provisoire est alors écrit dans le journal (docker compose logs app). S'il est choisi ici, au moins 10 caractères, et le
# retirer après le premier démarrage. Dans les deux cas, il est à changer à la première connexion.
ADMIN_LOGIN=admin
ADMIN_MOT_DE_PASSE=
# Image publiée par la CI, pour déployer sans reconstruire. En production, fixer une version publiée :
# MEP_IMAGE=ghcr.io/soladevsolide/gestion-mep:1.0.0
# (console) Adresse publique de l'application derrière le reverse proxy. Facultative : utile pour la connexion Microsoft (SSO),
# dont l'adresse de retour en dépend ; vide, elle est déduite de la requête.
# URL_PUBLIQUE=https://mep.entreprise.fr
# (console) Taille maximale d'une pièce jointe, en Mo (fichiers stockés dans le volume pieces-jointes)
PIECES_TAILLE_MAX_MO=20
# (console) Plafonds des pièces jointes, en Mo (0 = sans limite) : total par MEP, dépôts d'un compte sur 24 heures, et espace
# toujours laissé libre sur le disque (en dessous, les dépôts sont refusés pour protéger la base et les sauvegardes)
# PIECES_QUOTA_MEP_MO=1024
# PIECES_QUOTA_COMPTE_JOUR_MO=1024
# PIECES_ESPACE_LIBRE_MIN_MO=2048
# (console) Réseau(x) du reverse proxy HTTPS (CIDR, séparés par des virgules). Défaut : réseaux Docker (proxy sur le même hôte).
# Si le proxy est sur une autre machine, indiquer son adresse, par exemple 10.0.5.12/32.
# PROXY_RESEAUX=172.16.0.0/12
# (console) Tentatives de connexion autorisées par minute et par adresse IP (en plus du blocage d'un compte, depuis l'adresse qui
# échoue, après 5 échecs)
# CONNEXIONS_PAR_MINUTE=20
# (console) Écrans suivis en temps réel en même temps sur le serveur (20 au plus par compte)
# FLUX_MAX=1000
# (console) false : mode d'essai, la session fonctionne aussi en http simple (mots de passe en clair sur le réseau)
# HTTPS_OBLIGATOIRE=true
# (console) false : ne jamais interroger GitHub pour signaler une nouvelle version (serveur sans accès à Internet)
# VERIFIER_MISES_A_JOUR=true
# (console) Lien « Signaler un problème ou une idée » du menu utilisateur (vide : masqué), par exemple un outil interne
# LIEN_SIGNALEMENT=https://github.com/SolaDevSolide/gestion-mep/issues/new/choose
# mise-a-jour : active le bouton « Mettre à jour » de la console (service avec accès à Docker, voir docs/Exploiter.md)
# COMPOSE_PROFILES=mise-a-jour
